# /etc/secretproxy/gateway.env  (root:root 0644, contains NO secrets)
# Read by secretproxy-egress.service, secretproxy.service and egress-rules.sh.
# systemd syntax: KEY=value only, comments on their own lines.

# --- Topology A: dedicated gateway VM, clients on an isolated network (recommended)
MODE=routed
# NIC on the isolated sandbox network (check with: ip -br addr)
SANDBOX_IFACE=eth1
# The redirect delivers to the sandbox-facing address, so listen on all addresses;
# the egress rules refuse any connection to the port that was not redirected.
LISTEN_HOST=0.0.0.0
# Clients use this VM as their DNS server (dnsmasq allowlist)
ALLOW_DNS=1

# --- Topology C: proxy and client app on the same VM
# (comment out the block above and uncomment these)
#MODE=local
# the user(s) the client app runs as; never root, never in sudo/docker groups
#SANDBOX_USERS=agent
#LISTEN_HOST=127.0.0.1

PROXY_USER=secretproxy
PROXY_PORT=8080

# /etc/systemd/system/secretproxy.service
# The transparent secret-injection proxy, as an unprivileged, sandboxed service.
[Unit]
Description=secretproxy transparent secret-injection proxy
After=network-online.target secretproxy-egress.service
Wants=network-online.target
Requires=secretproxy-egress.service

[Service]
Type=simple
User=secretproxy
Group=secretproxy
EnvironmentFile=/etc/secretproxy/gateway.env
Environment=PYTHONUNBUFFERED=1

# Secrets as systemd credentials: stored encrypted in /etc/secretproxy/credentials/,
# decrypted only into this service's private /run/credentials/secretproxy.service/.
# In config.yaml:  value: file:${CREDENTIALS_DIRECTORY}/<name>
# Add one line per secret (see README, "Configure secrets"):
#LoadCredentialEncrypted=openai:/etc/secretproxy/credentials/openai.cred
#LoadCredentialEncrypted=anthropic:/etc/secretproxy/credentials/anthropic.cred

ExecStart=/opt/secretproxy/venv/bin/secretproxy run \
    -c /etc/secretproxy/config.yaml \
    --confdir /var/lib/secretproxy/ca \
    --listen-host ${LISTEN_HOST} --port ${PROXY_PORT}
Restart=always
RestartSec=2

# State, logs and file permissions
StateDirectory=secretproxy
StateDirectoryMode=0700
LogsDirectory=secretproxy
LogsDirectoryMode=0750
UMask=0077

# Hardening: no privileges at all, read-only OS, private /tmp and /dev
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target

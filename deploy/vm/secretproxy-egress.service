# /etc/systemd/system/secretproxy-egress.service
# Installs the egress rules before networking comes up, so the sandbox never has
# a window of direct access. Deliberately no ExecStop: stopping the proxy leaves
# the rules in place and the sandbox fails closed (connections are refused).
[Unit]
Description=secretproxy egress rules (sandbox traffic to the proxy, everything else refused)
DefaultDependencies=no
After=local-fs.target nftables.service ufw.service
Before=network-pre.target secretproxy.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/secretproxy/gateway.env
ExecStart=/opt/secretproxy/egress-rules.sh apply

[Install]
WantedBy=multi-user.target
